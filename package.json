{
  "name": "dsh-fleet",
  "version": "1.0.0-alpha.1",
  "description": "Decentralized multi-device fleet for DeepSeek Harness: signed roster, PIN join, mutual-TLS port, heartbeat, mDNS and Tailscale discovery",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-fleet": "bin/dsh-fleet.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:desktop": "node scripts/test-desktop.mjs"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "fleet",
    "a2a",
    "multi-device"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "react": ">=16.8 <20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@peculiar/asn1-schema": "^3.0.0",
    "@peculiar/x509": "^3.1.0",
    "asn1js": "^4.0.0",
    "bonjour-service": "^1.4.4",
    "reflect-metadata": "^0.2.2"
  }
}
