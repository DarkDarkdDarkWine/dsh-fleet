{
  "name": "dsh-fleet",
  "version": "0.3.2",
  "description": "Multi-device fleet for DeepSeek Harness: steward sessions, peer heartbeat/roster, and A2A message delivery over the tailnet",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-fleet": "bin/dsh-fleet.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "bin/dsh-fleet.js",
    "cordis.patch.yml",
    "skills/fleet-ops/SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "fleet",
    "a2a",
    "multi-device"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "react": ">=16.8 <20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
